# Tool locations for this machine. Copy to .env and fill in real paths:
#
#   cp .env.example .env
#
# .env is git-ignored. It is read by src/run_gem5.sh, src/main.py,
# src/validate_mcpat.py, python -m power.characterize and the tests.
# Variables already exported in your shell take precedence.
#
# Format: KEY=VALUE per line, whole-line # comments only, optional matching
# quotes around the value. Use absolute paths; $VAR and ~ are not expanded.

# gem5 checkout (ARM core configs are read from $GEM5_ROOT/configs)
GEM5_ROOT=/path/to/gem5

# gem5 ARM binary
GEM5_BIN=/path/to/gem5/build/ARM/gem5.opt

# McPAT binary (see README: built into <project>/tools/mcpat/mcpat)
MCPAT_BIN=/path/to/ARM_CACHE_Power_Model/tools/mcpat/mcpat
